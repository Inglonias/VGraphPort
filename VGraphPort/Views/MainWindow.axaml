<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VGraphPort.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="using:VGraphPort.Views"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="VGraphPort.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding WindowTitle}">
        
    
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>
    <Window.KeyBindings>
        <KeyBinding Gesture="W" Command="{Binding MoveThingsUpCommand}"/>
        <KeyBinding Gesture="A" Command="{Binding MoveThingsLeftCommand}"/>
        <KeyBinding Gesture="S" Command="{Binding MoveThingsDownCommand}"/>
        <KeyBinding Gesture="D" Command="{Binding MoveThingsRightCommand}"/>
        <KeyBinding Gesture="Delete" Command="{Binding DeleteThingsCommand}"/>
    </Window.KeyBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0">
            <local:MenuBarControl x:Name="MainMenuBar"></local:MenuBarControl>
        </DockPanel>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Visible">
            <local:MainCanvas DataContext="{Binding CanvasModel}" x:Name="PrimaryDrawingPanel" RenderEvent="PrimaryDrawingPanel_OnRenderEvent"/>
        </ScrollViewer>
    </Grid>

</Window>
